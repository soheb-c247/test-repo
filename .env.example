APP_NAME="AccuCare Pathology Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Laboratory timezone: all dates are stored and displayed in this zone.
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=accucare
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Administrator provisioning (php artisan db:seed / AdminUserSeeder)
# The single administrator is created from these values. The password is
# hashed on seeding; set it here only for the initial seed, never commit it.
# --------------------------------------------------------------------------
ADMIN_NAME="Lab Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --------------------------------------------------------------------------
# Laboratory identity printed on reports (leave blank to omit a line).
# Signatory names/titles must be supplied by the laboratory.
# --------------------------------------------------------------------------
LAB_NAME="AccuCare Pathology Lab"
LAB_TAGLINE="Accurate diagnostics. Compassionate care."
LAB_ADDRESS=
LAB_PHONE=
LAB_EMAIL=
LAB_WEBSITE=
LAB_REGISTRATION_NUMBER=
LAB_REPORT_PREFIX=ACP
LAB_BILL_PREFIX=BILL
LAB_PATIENT_PREFIX=PT
LAB_CURRENCY="₹"
LAB_SIGNATORY_1_NAME=
LAB_SIGNATORY_1_TITLE=
LAB_SIGNATORY_2_NAME=
LAB_SIGNATORY_2_TITLE=
LAB_REPORT_FOOTER="Results relate only to the sample received. Please correlate clinically."

# Create synthetic demo patients/reports during `php artisan db:seed`.
SEED_DEMO_DATA=false
